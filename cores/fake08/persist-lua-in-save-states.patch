 void Vm::deserializeLuaState(const char* src, size_t len) {
+    // Eris rebuilds the cart's functions piece by piece, and a collection in the middle frees
+    // prototypes it is still filling in: restoring a real cart's state then reads freed memory
+    // and corrupts the heap. Nothing is collected until the restore is done.
+    lua_gc(_luaState, LUA_GCSTOP, 0);
     lua_getglobal(_luaState, "eris");
 	lua_getfield(_luaState, -1, "restore_all");
 	lua_pushlstring(_luaState, src, len);
 
 	if (lua_pcall(_luaState, 1, 0, 0) != 0) {
 		std::string e = lua_tostring(_luaState, -1);
-		lua_pop(_luaState, 1);
+		Logger_Write("Error restoring lua state: %s\n", e.c_str());
+		lua_pop(_luaState, 2);
+		lua_gc(_luaState, LUA_GCRESTART, 0);
 		return;
 	}
 	lua_pop(_luaState, 1);
